<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Monday 06:00 ET settlement audit, reported to Telegram.

       WHY LAUNCHD AND NOT AN IN-SESSION CRON: an in-session scheduler dies with the
       session, and this has to survive until next Monday. launchd persists across
       logout and reboot, and StartCalendarInterval catches up a missed run if the Mac
       was asleep at the fire time — which is the whole point of a weekly check.

       06:00 ET is ~1h after the calendar-pinned close (Mon 04:59 UTC = Sun 23:59 ET),
       leaving Chainlink time to settle before we judge it stalled.

       The job is READ-ONLY. It never sends a chain transaction: recovering a stalled
       round needs a Bank wallet transaction, and that needs Jim's explicit go-ahead. -->
  <key>Label</key><string>io.temptationtoken.round-audit</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd /Users/functionisedproductions/Projects/temptation-token &amp;&amp; set -a &amp;&amp; . ./.env &amp;&amp; set +a &amp;&amp; /usr/bin/env node scripts/verify-round-settlement.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/functionisedproductions/Projects/temptation-token</string>
  <key>StandardOutPath</key><string>/Users/functionisedproductions/Projects/temptation-token/logs/round-audit.log</string>
  <key>StandardErrorPath</key><string>/Users/functionisedproductions/Projects/temptation-token/logs/round-audit.err</string>
  <!-- THREE fire times, not one. The original Monday 06:00 slot only ever asked
       "did last night's settlement work?" — a post-mortem. Chainlink's Base
       Automation registry went dark on 2026-08-05 and rounds 6 and 7 each closed
       unsettled for ~18 hours before a human noticed, so the useful alert is the
       one that arrives BEFORE the close, while there is still time to be ready.

         Sun 20:00 ET — ~5h before close. Pre-flight: is automation alive at all?
         Mon 02:00 ET — ~1h after the 00:59 ET close. Catches a stall same night.
         Mon 06:00 ET — backstop, and the catch-up run if the Mac was asleep.

       Still READ-ONLY at every fire time; recovery needs a Bank transaction. -->
  <key>StartCalendarInterval</key><array>
    <dict>
      <key>Weekday</key><integer>0</integer>
      <key>Hour</key><integer>20</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>2</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
</dict></plist>
