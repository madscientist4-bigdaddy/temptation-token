# EAS Build runs `npm ci --include=dev`, which fails unless the lockfile records every
# nested peer install its npm would make.
#
# The wallet stack creates an unsatisfiable peer graph against Expo SDK 57:
#   * 9 copies of @walletconnect/keyvaluestorage peer-need
#     @react-native-async-storage/async-storage@1.x
#   * the app (correctly, per `expo install --check`) holds async-storage 2.2.0
#   * several @solana/* and ox packages peer-need typescript ^5, the app holds 6.0.3
#
# Auto-installing those peers means nesting a SECOND async-storage (1.24.0) and a second
# typescript (5.9.3) inside node_modules. That is what the EAS worker's npm tried to do,
# found absent from the lockfile, and failed on with EUSAGE — while npm 11.6.2 locally
# resolved the same tree without recording them, so it passed here and only here.
#
# Turning peer auto-install off makes both resolvers agree: no nested peer copies are
# expected, so the lockfile is complete by construction. It is safe here because the
# peer ranges are advisory for these packages — async-storage 2.x is API-compatible for
# the get/set/remove surface keyvaluestorage uses, and typescript is build-time only and
# never shipped in the bundle.
legacy-peer-deps=true
