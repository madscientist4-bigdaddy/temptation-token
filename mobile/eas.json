{
  "cli": { "version": ">= 5.9.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "true" }
    },
    "apk": {
      "distribution": "internal",
      "channel": "apk",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "false" }
    },
    "apk-wallet": {
      "distribution": "internal",
      "channel": "apk-wallet",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_WALLET_ENABLED": "true",
        "EXPO_PUBLIC_GASLESS_ENABLED": "true",
        "EXPO_PUBLIC_GASLESS_PAYMASTER": "https://app.temptationtoken.io/api/paymaster"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "ios-simulator",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "false" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "true" }
    },
    "testflight": {
      "distribution": "store",
      "channel": "testflight",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_WALLET_ENABLED": "true",
        "EXPO_PUBLIC_GASLESS_ENABLED": "true",
        "EXPO_PUBLIC_GASLESS_PAYMASTER": "https://app.temptationtoken.io/api/paymaster",
        "EXPO_PUBLIC_STAKING_LIVE": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_WALLET_ENABLED": "true",
        "EXPO_PUBLIC_STAKING_LIVE": "false"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    }
  }
}
