{
  "cli": { "version": ">= 5.9.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "true" }
    },
    "apk": {
      "distribution": "internal",
      "channel": "apk",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "false" }
    },
    "apk-wallet": {
      "distribution": "internal",
      "channel": "apk-wallet",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "true" }
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "ios-simulator",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "false" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_WALLET_ENABLED": "true" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_WALLET_ENABLED": "true",
        "EXPO_PUBLIC_STAKING_LIVE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
